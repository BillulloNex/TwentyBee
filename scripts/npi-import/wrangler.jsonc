{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "npi-import-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NpiImportContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NPI_IMPORT",
        "class_name": "NpiImportContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NpiImportContainer"]
    }
  ]
}
